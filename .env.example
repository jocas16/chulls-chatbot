# ============================================================
#  CHULLS Bot - variables de entorno
#  Copia este archivo como .env y completa tus valores.
#  El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

# Clave de API de DeepSeek (https://platform.deepseek.com/api_keys)
# Si la dejas vacía, el bot funciona en modo demostración (sin LLM).
DEEPSEEK_API_KEY=

# Modelo y URL base (API compatible con OpenAI)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# auto = usa DeepSeek si hay clave; demo = fuerza respuestas locales sin red
MODO=auto

# Ruta de la base de datos SQLite (se crea sola)
DB_PATH=data/chulls.db

# Límites de la conversación
MAX_CARACTERES=1000
TURNOS_HISTORIAL=6

# Servidor (usado por: python -m app)
HOST=127.0.0.1
PORT=8000
